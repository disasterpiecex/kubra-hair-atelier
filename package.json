{
  "name": "kubra-hair-atelier",
  "version": "1.5.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:android:apk": "eas build -p android --profile preview",
    "build:android:aab": "eas build -p android --profile production",
    "android:prebuild": "expo prebuild --platform android --clean",
    "android:debug-apk": "npm run android:prebuild && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.17",
    "expo-image-picker": "~57.0.16",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
